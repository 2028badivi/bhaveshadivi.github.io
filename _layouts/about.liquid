---
layout: default
---
<div class="post">
  <header class="post-header">
    <div class="name-dna-container" style="display: flex; align-items: flex-start; gap: 0.5rem; flex-wrap: wrap;">
      <h1 class="post-title" style="margin: 0;">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      <img src="{{ '/assets/img/tjhsst-logo.jpg' | relative_url }}" alt="TJHSST" class="tjhsst-logo" style="width: 48px; height: 48px; object-fit: contain; border-radius: 6px; flex-shrink: 0; margin-left: 0.25rem; margin-top: 0.3rem;">
      <div class="dna-divider-home" aria-hidden="true" style="flex: 0 0 auto; width: 120px; height: 20px; margin-left: 0.25rem;">
        <svg width="140" height="24" viewBox="0 0 140 24" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="dnaGradientHome" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" style="stop-color:#239a3b;stop-opacity:0.9" />
              <stop offset="50%" style="stop-color:#196127;stop-opacity:1" />
              <stop offset="100%" style="stop-color:#239a3b;stop-opacity:0.9" />
            </linearGradient>
            <filter id="dnaGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="1.5" result="coloredBlur"/>
              <feMerge>
                <feMergeNode in="coloredBlur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>
          <!-- Left helix strand - single continuous wave -->
          <path d="M 6 2 C 14 2 22 8 30 8 C 38 8 46 14 54 14 C 62 14 70 20 78 20 C 86 20 94 14 102 14 C 110 14 116 20 124 20 C 132 20 138 8 138 8" fill="none" stroke="url(#dnaGradientHome)" stroke-width="1.8" stroke-linecap="round" filter="url(#dnaGlow)"/>
          <!-- Right helix strand - offset wave -->
          <path d="M 6 20 C 14 20 22 14 30 14 C 38 14 46 8 54 8 C 62 8 70 2 78 2 C 86 2 94 8 102 8 C 110 8 116 2 124 2 C 132 2 138 8 138 8" fill="none" stroke="url(#dnaGradientHome)" stroke-width="1.8" stroke-linecap="round" filter="url(#dnaGlow)"/>
          <!-- Base pairs (rungs) - fewer, more realistic -->
          <line x1="6" y1="6" x2="30" y2="6" stroke="#c6e48b" stroke-width="1" opacity="0.7"/>
          <line x1="30" y1="14" x2="54" y2="14" stroke="#7bc96f" stroke-width="1" opacity="0.7"/>
          <line x1="54" y1="20" x2="78" y2="20" stroke="#c6e48b" stroke-width="1" opacity="0.7"/>
          <line x1="78" y1="2" x2="102" y2="2" stroke="#7bc96f" stroke-width="1" opacity="0.7"/>
          <line x1="102" y1="8" x2="124" y2="8" stroke="#c6e48b" stroke-width="1" opacity="0.7"/>
          <line x1="124" y1="16" x2="134" y2="16" stroke="#239a3b" stroke-width="1" opacity="0.7"/>
        </svg>
      </div>

      {% if page.profile %}
        <div class="profile" style="margin-left: auto; margin-top: 0; flex-shrink: 0;">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <p class="desc">{{ page.subtitle }}</p>
    <hr class="section-divider">
  </header>

  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note-row">
          {{ site.contact_note }} <span class="social-arrow-email"></span>
        </div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>

<style>
/* Affiliations - each on its own line */
.affiliations {
  display: block;
  margin-bottom: 0.1rem;
  white-space: normal;
  position: relative;
  top: -2.5rem;
}
/* Pull the first affiliation (and the divider below it) up a bit more */
.desc + .affiliations {
  margin-top: -3rem;
}

/* Contact note - below icons, arrow points up to email icon */
.social .contact-note-row {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.85rem;
  color: var(--color-fg-muted, #57606a);
  line-height: 1.4;
  margin-top: 0;
}
.social .contact-note-row .social-arrow-email {
  position: relative;
  display: inline-block;
  padding-top: 16px;
  margin-left: 6px;
  color: var(--color-fg-muted, #57606a);
}
.social .contact-note-row .social-arrow-email::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 7px solid transparent;
  border-right: 7px solid transparent;
  border-bottom: 10px solid currentColor;
}
.social .contact-note-row .social-arrow-email::after {
  content: "";
  position: absolute;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  width: 2px;
  height: 14px;
  background: currentColor;
}
.social .contact-icons {
  display: flex;
  gap: 1rem;
  justify-content: flex-start;
  align-items: center;
  flex-wrap: wrap;
}
.social .contact-icons a {
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}
/* Make the email icon (5th = last) larger and more prominent */
.social .contact-icons a:nth-child(5) {
  transform: scale(1.3);
  z-index: 2;
  position: relative;
  margin-left: 0.5rem;
}
.social .contact-icons a:nth-child(5) i,
.social .contact-icons a:nth-child(5) svg {
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));
}

/* DNA design on homepage - from name to right */
.dna-divider-home {
  display: block;
  margin: 0 0.5rem;
  position: relative;
  top: 0.4rem;
}
.dna-svg-home {
  width: 100%;
  height: 24px;
  display: block;
}

.name-dna-container {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.desc {
  white-space: normal;
  width: 100%;
  line-height: 1.5;
  margin-top: 0;
  margin-bottom: 0.1rem;
}

.profile {
  max-width: 200px;
  flex-shrink: 0;
}
.profile .img-fluid {
  max-width: 100%;
  height: auto;
}
.profile .more-info {
  white-space: normal;
  line-height: 1.4;
  font-size: 0.85rem;
  margin-top: 0.5rem;
}

/* Keep intro paragraph from stretching too wide */
article p {
  max-width: 65ch;
  line-height: 1.6;
  margin-top: 0;
  margin-bottom: 0.5rem;
}

/* Divider between header section and paragraph */
.section-divider {
  border: 0;
  border-top: 1px solid var(--color-border-default, #d0d7de);
  margin: -0.2rem 0 0.1rem;
  width: 100%;
}

/* Pull the intro block (icons + note) up a bit */
.social {
  margin-top: 0;
}

</style>
